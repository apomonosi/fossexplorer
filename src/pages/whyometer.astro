---
import Layout from '../layouts/Layout.astro';
import WhyometerView from '../components/Whyometer';
---

<Layout title="Why-ometer - FOSS Explorer" description="Strategic urgency indicators for Linux & FOSS adoption">
  <div class="page-wrapper">
    <nav class="page-nav">
      <a href="/" class="back-link">&lt; Back to FOSS Explorer</a>
    </nav>
    <WhyometerView client:only="react" />
  </div>
</Layout>

<style>
  .page-wrapper {
    min-height: 100vh;
    background: linear-gradient(170deg, #020617 0%, #0a0f1a 50%, #060a13 100%);
  }
  .page-nav {
    padding: 16px 32px;
    border-bottom: 1px solid rgba(148, 163, 184, 0.1);
  }
  .back-link {
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
    color: #64748b;
    text-decoration: none;
    transition: color 0.2s;
  }
  .back-link:hover {
    color: #22d3ee;
  }
</style>
